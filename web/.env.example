# Where the Python API lives. Locally the dev launcher (python -m api.dev) listens on 8000.
# On Vercel, set this to your Hugging Face Space URL, e.g. https://your-name-nudge-api.hf.space
BACKEND_URL=http://127.0.0.1:8000

# Optional. Leave unset so "Launch app" opens the built-in /studio.
# NEXT_PUBLIC_APP_URL=
