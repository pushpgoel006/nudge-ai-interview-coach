# Copy to .env (never commit .env). Only the first three are required.

# LLM
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key

# Postgres connection string, e.g. a Neon database. `python -m api.dev` ignores this and uses a throwaway SQLite file.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname
# Used only by database/init_db.py (a non-pooled connection).
# DATABASE_URL_UNPOOLED=

# API (see api/README.md for all the limits)
# Long random string that signs login cookies. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=
# Comma-separated site origins allowed to call the API, e.g. your Vercel URL.
API_ALLOWED_ORIGINS=http://localhost:3000
# API_ENV=production
